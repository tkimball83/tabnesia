{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/tkimball83/tabnesia",
  "icons": {
    "16": "icons/tabnesia.svg",
    "32": "icons/tabnesia.svg",
    "48": "icons/tabnesia.svg",
    "96": "icons/tabnesia.svg"
  },
  "action": {
    "default_icon": "icons/tabnesia.svg",
    "default_title": "__MSG_extensionName__"
  },
  "permissions": ["storage", "sessions"],
  "incognito": "spanning",
  "background": {
    "scripts": ["background.mjs"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabnesia@tkimball83.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
