{
  "manifest_version": 3,
  "name": "Tabnesia",
  "version": "1.0.1",
  "description": "Keeps pinned tabs ordered and resets URLs when activated.",
  "icons": {
    "16": "icons/tabnesia.svg",
    "32": "icons/tabnesia.svg",
    "48": "icons/tabnesia.svg",
    "96": "icons/tabnesia.svg"
  },
  "permissions": ["storage", "sessions"],
  "incognito": "spanning",
  "background": {
    "scripts": ["background.mjs"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabnesia@tkimball83.github.io",
      "strict_min_version": "148.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
